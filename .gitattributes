* text=auto

# LF line endings for source files
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Frozen JSON evidence is hashed as bytes, including its original line endings.
experiment/manifests/** -text

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.sqlite binary
*.zip binary
