* text=auto

*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Preserve the exact bytes used by evidence checksums.
experiment/manifests/** -text
experiment/results/** -text whitespace=cr-at-eol

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.sqlite binary
*.zip binary
*.gz binary
